POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Gateway : secret de signature des JWT (>= 32 octets) et mot de passe commun des comptes de démonstration
JWT_SECRET=remplacez-par-une-longue-valeur-aleatoire-de-32-octets-minimum
DEMO_PASSWORD=remplacez-moi

# Observabilité (profil Docker "observability") : mot de passe du compte admin de Grafana
GRAFANA_PASSWORD=remplacez-moi

# Service IA (facultatif) : clé d'API pour le résumé par modèle de langage. Laisser vide = résumé par modèle de phrases.
ANTHROPIC_API_KEY=

# Compte de service du SOAP (WS-Security UsernameToken) : partagé par le SOAP, la Gateway et l'orchestrateur
EHR_SERVICE_PASSWORD=remplacez-par-un-mot-de-passe-long-et-aleatoire
